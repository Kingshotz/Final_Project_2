        <classes>
            <class name="tests.ui.CurrecyExchangeScenario"/>
            <class name="tests.ui.MortgageCalculatorHappyPathScenario"/>
            <class name="tests.ui.MortgageCalculatorNegativeScenario"/>
            <class name="tests.ui.BranchesScenario"/>
